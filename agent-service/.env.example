COMPOSE_PROJECT_NAME=hm-insurance
LOG_LEVEL=INFO
LOG_FORMAT=console

# PostgreSQL - biz-service
POSTGRES_BIZ_DB=change-me-with-real-db
POSTGRES_BIZ_USER=change-me-with-real-user
POSTGRES_BIZ_PASSWORD=change-me-with-real-password

# PostgreSQL - agent-service
POSTGRES_AGENT_DB=change-me-with-real-db
POSTGRES_AGENT_USER=change-me-with-real-user
POSTGRES_AGENT_PASSWORD=change-me-with-real-password
POSTGRES_PORT=5432
# Optional. If omitted, agent-service derives DATABASE_URL from
# INFRA_HOST + POSTGRES_AGENT_* when INFRA_HOST is configured.
DATABASE_URL=

# Redis
REDIS_PASSWORD=

# External VM/local infra host for CLI and health checks.
INFRA_HOST=
MILVUS_HOST=
MILVUS_PORT=19530
MILVUS_URI=
MILVUS_COLLECTION=insurance_knowledge_chunks

# Auth
JWT_ISSUER=hm-insurance
JWT_SECRET=change-me-in-dev
JWT_ACCESS_TOKEN_MINUTES=15
JWT_REFRESH_TOKEN_DAYS=7

# Service auth
SERVICE_API_KEY=change-me-service-api-key

# Service URLs
BUSINESS_SERVICE_URL=http://biz-service:8001
AGENT_SERVICE_URL=http://agent-service:8002

# LLM / model config placeholders
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
CHAT_MODEL=deepseek-chat
CHAT_TEMPERATURE=0.2
MARKDOWN_OPTIMIZER_TIMEOUT_SECONDS=180
MARKDOWN_OPTIMIZER_MODEL=deepseek-chat
MARKDOWN_OPTIMIZER_MAX_TOKENS=32000
OLLAMA_BASE_URL=http://ollama:11434
MINERU_TOKEN=replace-with-mineru-token
MINERU_API_BASE_URL=
MINERU_FLASH_BASE_URL=
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DEVICE=cpu
EMBEDDING_MAX_LENGTH=8192
RERANK_MODEL=BAAI/bge-reranker-v2-m3
RERANK_DEVICE=cpu
RERANK_MAX_LENGTH=512
RAG_CANDIDATE_K=50
RAG_AUTO_FULL_MIN_SAME_PARENT_HITS=2
